# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Next.js & Vite)
# Preencha com as credenciais do seu projeto Supabase:
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# RESEND CONFIGURATION
# Chave de API do Resend (obtenha em https://resend.com/api-keys):
RESEND_API_KEY="re_123456789_abcdefg"
# E-mail remetente verificado no Resend (ou use o de teste 'onboarding@resend.dev'):
RESEND_FROM_EMAIL="Silva e Sol <onboarding@resend.dev>"

# MELHOR ENVIO CONFIGURATION
# Token de webhook para validar eventos de rastreio enviados pelo Melhor Envio:
MELHOR_ENVIO_WEBHOOK_SECRET="seu-token-secreto-webhook"
# Token opcional para cotação direta na API do Melhor Envio (se aplicável):
MELHOR_ENVIO_API_TOKEN=""
MELHOR_ENVIO_ENVIRONMENT="sandbox" # ou "production"

# STONE / PAGAR.ME CONFIGURATION
# Chave de API da Stone / Pagar.me (quando fornecida pela operadora em produção):
# OBS: Se deixada vazia ou não informada, o sistema ativa AUTOMATICAMENTE o MODO SIMULAÇÃO (Sandbox Fallback),
# permitindo testar PIX e Cartão de Crédito normalmente sem quebrar o checkout da loja.
STONE_API_KEY=""
STONE_ENCRYPTION_KEY=""

